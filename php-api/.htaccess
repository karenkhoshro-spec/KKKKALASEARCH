# KalaSearch — public_html/api/.htaccess
# Copy with the API files:  php-api/*  →  public_html/api/
# Every /api/* request is routed to the front controller index.php.
# The SPA .htaccess in public_html/ already passes /api/* through untouched.

Options -Indexes
RewriteEngine On

# cPanel / Apache / LiteSpeed / PHP-FPM often strip the Authorization header
# before it reaches PHP. Restore it so Bearer tokens work for:
#   GET  /api/admin/session
#   GET  /api/admin/orders
#   POST /api/admin/logout
#   PATCH /api/admin/orders/.../status
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Block direct access to internal PHP modules and configuration files.
RewriteRule ^lib/ - [F,L]
RewriteRule ^config.*\.php$ - [F,L]
RewriteRule ^images-mapping\.json$ - [F,L]

# Everything else → the front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
