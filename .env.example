# Public frontend configuration only. Never put API keys or tokens here.
VITE_DATA_PROVIDER_MODE=local-csv
VITE_API_BASE_URL=
VITE_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Local Node development only (npm run dev / npm run start).
# Production cPanel does NOT read this file. On cPanel, admin username,
# bcrypt hash, session secret, and DB credentials live in
# kalasearch-config.php OUTSIDE public_html (see docs/CPANEL_PHP_DEPLOYMENT.md).
# Never prefix admin keys with VITE_. Never put real passwords here or in git.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Future backend-only variables (do not expose with VITE_):
# ASHKAN_API_URL=
# ASHKAN_API_KEY=
# ASHKAN_API_TOKEN=
